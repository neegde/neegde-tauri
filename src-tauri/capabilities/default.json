{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "app-debug*",
    "player-viz*"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "opener:default",
    "deep-link:default"
  ]
}